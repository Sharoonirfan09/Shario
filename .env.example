# Contact form delivery (app/actions.ts, submitEnquiry)
#
# The form itself is fully built and already defaults recipient delivery to
# info@shario.ae — it only needs these two variables set to actually send.
# Without them, submitEnquiry() logs an error and returns a clear failure
# message to the visitor rather than silently pretending to have sent it.
#
# Setup (Resend — https://resend.com):
#   1. Create a Resend account and add/verify the shario.ae domain (Resend
#      will give you a few DNS records — SPF/DKIM — to add wherever shario.ae
#      is managed; verification is usually near-instant once they're live).
#   2. Generate an API key in the Resend dashboard and set it below.
#   3. Set ENQUIRY_FROM_EMAIL to an address on the verified domain, e.g.
#      "Shario <enquiries@shario.ae>" — Resend rejects unverified senders.
#   4. Add both variables to your deployment's environment (e.g.
#      `vercel env add RESEND_API_KEY` / `vercel env add ENQUIRY_FROM_EMAIL`,
#      or the Vercel dashboard's Project Settings → Environment Variables),
#      then redeploy.

RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Shario <enquiries@shario.ae>"

# Optional — overrides the recipient. Leave unset and it defaults to
# `site.email` in lib/site.ts, which is already info@shario.ae.
# ENQUIRY_TO_EMAIL=info@shario.ae
