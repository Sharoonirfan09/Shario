# Contact form delivery (app/actions.ts, submitEnquiry)
#
# The form itself is fully built and already defaults recipient delivery to
# info@shario.ae — it only needs these two variables set to actually send.
# Without them, submitEnquiry() logs an error and returns a clear failure
# message to the visitor rather than silently pretending to have sent it.
#
# Setup (Resend — https://resend.com):
#   1. Create a Resend account and add/verify the shario.ae domain (Resend
#      will give you a few DNS records — SPF/DKIM — to add wherever shario.ae
#      is managed; verification is usually near-instant once they're live).
#   2. Generate an API key in the Resend dashboard and set it below.
#   3. Set ENQUIRY_FROM_EMAIL to an address on the verified domain, e.g.
#      "Shario <enquiries@shario.ae>" — Resend rejects unverified senders.
#   4. Add both variables to your deployment's environment (e.g.
#      `vercel env add RESEND_API_KEY` / `vercel env add ENQUIRY_FROM_EMAIL`,
#      or the Vercel dashboard's Project Settings → Environment Variables),
#      then redeploy.

RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Shario <enquiries@shario.ae>"

# Optional — overrides the recipient. Leave unset and it defaults to
# `site.email` in lib/site.ts, which is already info@shario.ae.
# ENQUIRY_TO_EMAIL=info@shario.ae

# Analytics (components/analytics.tsx)
#
# Both are optional and inert until set — GoogleAnalytics/FacebookPixel
# render nothing at all (no script tag, no request) while these are unset,
# exactly as the site behaves today. No placeholder/fake ID belongs here;
# leave a line blank or deleted until you have the real value.
#
# GA4 — Measurement ID from Google Analytics: Admin → Data Streams → your
# web stream → "Measurement ID" (looks like G-XXXXXXXXXX).
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta/Facebook Pixel — numeric Pixel ID from Meta Events Manager: Data
# Sources → your pixel → Settings (not the access token).
# NEXT_PUBLIC_FB_PIXEL_ID=

# Firebase (lib/firebase.ts)
#
# Client-side config from Firebase console → Project settings → General →
# your web app → SDK setup and configuration. These values are safe to
# expose to the browser (NEXT_PUBLIC_*) — Firebase security rules, not
# secrecy of this config, protect your data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Analytics (components/firebase-analytics.tsx)
#
# Optional and inert until set. Enable Google Analytics for the project in
# Firebase console → Project settings → Integrations to mint this ID, then
# set it here and redeploy — no code change needed. Note this is a second
# GA4 stream alongside NEXT_PUBLIC_GA_MEASUREMENT_ID above; point both at
# the same GA4 property to avoid double-counting pageviews.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# /admin sign-in allowlist (components/admin-gate.tsx)
#
# Comma-separated Google account emails permitted past sign-in at /admin.
# Google sign-in alone only proves *a* Google account signed in — this list
# is what actually restricts access. Requires the Google provider to be
# enabled in Firebase console → Authentication → Sign-in method.
NEXT_PUBLIC_ADMIN_EMAILS=
